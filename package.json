{
  "name": "tech-dictionary",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An open tech dictionary built with Astro, TypeScript, and YAML.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate.mjs",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:dev && npm run build && npm run test:built",
    "test:dev": "node tests/dev.mjs",
    "new-term": "node scripts/new-term.mjs",
    "migrate:yaml": "node scripts/migrate-yaml.mjs",
    "test:built": "node --experimental-vm-modules tests/built.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "7.4.1",
    "bootstrap": "5.3.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@types/bootstrap": "5.2.11",
    "@types/node": "24.19.2",
    "jsdom": "26.1.0",
    "typescript": "6.0.3"
  }
}
