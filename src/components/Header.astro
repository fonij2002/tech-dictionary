---
import { site } from '../lib/site';
import { withBase } from '../lib/urls';
import Icon from './Icon.astro';
---

<header class="site-header">
  <div class="wrap header-inner d-flex align-items-center justify-content-between gap-3">
    <a
      class="brand d-inline-flex align-items-center text-decoration-none"
      href={withBase()}
      aria-label="Tech Dictionary home"
    >
      <img
        src={withBase('images/favicon.svg')}
        width="40"
        height="34"
        class="d-block flex-shrink-0 object-fit-contain"
        alt=""
      />
      <span>
        Tech Dictionary
      </span>
    </a>
    <nav class="header-nav d-flex align-items-center" aria-label="Main">
      <a class="dictionary-nav" href={withBase()}>
        Dictionary
      </a>
      <a href={withBase('data/')}>The data</a>
      <a class="nav-action btn btn-sm border" href={site.repository}>
        <Icon name="edit" size={16} />
        Contribute
      </a>
    </nav>
  </div>
</header>
