---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="custom-callout not-content">
  <h3>{title}</h3>
  <div class="custom-callout__body">
    <slot />
  </div>
</aside>

<style>
  .custom-callout {
    margin-block: 1.25rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .custom-callout h3 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }

  .custom-callout__body {
    margin-top: 0.5rem;
  }

  .custom-callout__body :global(p:first-child) {
    margin-top: 0;
  }

  .custom-callout__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
